{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022"
  },
  "include": [
    "*.js",
    "*.d.ts",
    "content/**/*.js",
    "extractors/**/*.js",
    "popup/**/*.js",
    "shared/**/*.js"
  ],
  "exclude": ["test", "scripts", "node_modules"]
}
