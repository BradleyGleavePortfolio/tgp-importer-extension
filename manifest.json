{
  "manifest_version": 3,
  "name": "TGP Importer",
  "version": "0.2.0-design",
  "description": "Transfer your TrueCoach clients into TGP from inside your own logged-in browser tab.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TGP Importer",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://app.truecoach.co/*",
    "https://api.tgp.coach/*",
    "*://*.tgp.coach/*",
    "*://*.truecoach.co/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://app.truecoach.co/*"],
      "js": ["content/main.js"],
      "run_at": "document_idle"
    }
  ]
}
