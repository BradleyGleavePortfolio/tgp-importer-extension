{
  "manifest_version": 3,
  "name": "TGP Importer",
  "version": "0.3.0",
  "version_name": "0.3.0-rc.1",
  "description": "Site-agnostic import bridge: capture client data from your prior coaching platform into TGP under your own logged-in browser session.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TGP Importer",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "notifications",
    "debugger"
  ],
  "host_permissions": [
    "https://app.truecoach.co/*",
    "https://*.truecoach.co/*",
    "https://api.tgp.coach/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://app.truecoach.co/*", "https://*.truecoach.co/*"],
      "js": ["content/main.js"],
      "run_at": "document_idle"
    }
  ]
}
